{
  "schema_version": 1,
  "executable_extensions": [
    ".py",
    ".pyw",
    ".ps1",
    ".psm1",
    ".psd1",
    ".mjs",
    ".cjs",
    ".js",
    ".cs",
    ".ts",
    ".tsx",
    ".jsx",
    ".vb",
    ".bat",
    ".cmd"
  ],
  "generated_cache_dirs": [
    ".git",
    "target",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".serena",
    ".codebase-memory",
    ".codegraph-harness-active",
    ".codegraph-harness-store"
  ],
  "external_roots": [
    {
      "path": ".venv",
      "reason": "Local Python environment owned by the external dependency lifecycle; not first-party tracked source."
    }
  ],
  "rust_source_roots": [
    "crates",
    "tools/rtk-adapter"
  ],
  "embedded_program_markers": [
    {
      "name": "python-shebang",
      "needle": "#!/usr/bin/env"
    },
    {
      "name": "python-short-shebang",
      "needle": "#!python"
    },
    {
      "name": "powershell-shebang",
      "needle": "#!pwsh"
    },
    {
      "name": "powershell-requires-header",
      "needle": "#requires -Version"
    },
    {
      "name": "inline-csharp-compilation",
      "needle": "Add-Type -TypeDefinition"
    },
    {
      "name": "embedded-csharp-source",
      "needle": "using System;"
    },
    {
      "name": "embedded-csharp-entrypoint",
      "needle": "static void Main"
    }
  ],
  "entries": [
    {
      "classification": "inert-data",
      "paths": [
        "tests/fixtures/lsp/delayed-mcp.py",
        "tests/fixtures/lsp/mcp-edit.py"
      ],
      "consumer": "crates/harness-core/src/analysis_samples.rs",
      "note": "Declared external-language analysis samples; native helpers refuse to execute them."
    }
  ]
}
