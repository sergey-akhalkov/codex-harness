{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -EncodedCommand ",
            "timeout": 10,
            "statusMessage": "Recording source revisions for diagnostics"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash|mcp__.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "harness-lsp",
            "tool": "diagnostics_after_tool",
            "timeout": 30,
            "statusMessage": "Checking changed source files",
            "input": {
              "event": "PostToolUse",
              "workspace": "${cwd}",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}",
              "transcript_path": "${transcript_path}"
            }
          },
          {
            "type": "command",
            "timeout": 30,
            "command": "pwsh -NoLogo -NoProfile -EncodedCommand ",
            "statusMessage": "Reconciling diagnostics when the native MCP hook is unavailable"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "harness-lsp",
            "tool": "diagnostics_after_tool",
            "timeout": 30,
            "statusMessage": "Reconciling pending diagnostics",
            "input": {
              "event": "Stop",
              "stop_hook_active": "${stop_hook_active}",
              "workspace": "${cwd}",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "transcript_path": "${transcript_path}"
            }
          },
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -EncodedCommand ",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "harness-lsp",
            "tool": "diagnostics_after_tool",
            "timeout": 30,
            "statusMessage": "Reconciling subagent diagnostics",
            "input": {
              "event": "SubagentStop",
              "stop_hook_active": "${stop_hook_active}",
              "workspace": "${cwd}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "turn_id": "${turn_id}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}"
            }
          },
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -EncodedCommand ",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
